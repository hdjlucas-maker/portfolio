# ── EmailJS (envio de e-mail) ──────────────────────────────
# Pegue esses valores em https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=seu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui

# ── CallMeBot (envio de WhatsApp) ──────────────────────────
# Numero SEU (o que vai receber os pedidos), formato internacional sem + nem espaços
# Ex: 5521976620148
VITE_CALLMEBOT_PHONE=5521976620148
VITE_CALLMEBOT_APIKEY=sua_apikey_aqui
